{
  "manifest_version": 3,
  "name": "Postcard",
  "version": "1.1.0",
  "description": "Turn any post on X into a clean image you can post anywhere.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://pbs.twimg.com/*",
    "https://abs.twimg.com/*",
    "https://video.twimg.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Postcard"
  }
}
